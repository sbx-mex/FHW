HTML Tienda - Impacto =
VAR Tienda =
    COALESCE ( SELECTEDVALUE ( 'FHW_Modelo'[Tienda] ), "Todas las tiendas" )
VAR DM =
    COALESCE ( SELECTEDVALUE ( 'FHW_Modelo'[DM] ), "Todos los DM" )
VAR SemanaActual =
    MAX ( 'FHW_Modelo'[SemanaID] )
VAR SemanaAnterior =
    MAXX (
        FILTER ( ALL ( 'FHW_Modelo'[SemanaID] ), 'FHW_Modelo'[SemanaID] < SemanaActual ),
        'FHW_Modelo'[SemanaID]
    )
VAR CTCActual =
    AVERAGEX (
        VALUES ( 'FHW_Modelo'[CeCo] ),
        CALCULATE ( DIVIDE ( SUM ( 'FHW_Modelo'[FHW] ), SUM ( 'FHW_Modelo'[Bebidas Lobby] ) ) )
    )
VAR CTCAnterior =
    IF (
        NOT ISBLANK ( SemanaAnterior ),
        CALCULATE (
            AVERAGEX (
                VALUES ( 'FHW_Modelo'[CeCo] ),
                CALCULATE ( DIVIDE ( SUM ( 'FHW_Modelo'[FHW] ), SUM ( 'FHW_Modelo'[Bebidas Lobby] ) ) )
            ),
            REMOVEFILTERS ( 'FHW_Modelo'[SemanaID] ),
            'FHW_Modelo'[SemanaID] = SemanaAnterior
        )
    )
VAR Movimiento = CTCActual - CTCAnterior
VAR FHWValor = SUM ( 'FHW_Modelo'[FHW] )
VAR LobbyValor = SUM ( 'FHW_Modelo'[Bebidas Lobby] )
VAR Tiendas = DISTINCTCOUNT ( 'FHW_Modelo'[CeCo] )
VAR ConUso =
    COUNTROWS (
        FILTER (
            VALUES ( 'FHW_Modelo'[CeCo] ),
            CALCULATE ( DIVIDE ( SUM ( 'FHW_Modelo'[FHW] ), SUM ( 'FHW_Modelo'[Bebidas Lobby] ) ) ) > 0
        )
    )
VAR Cobertura = DIVIDE ( ConUso, Tiendas )
VAR SemanasBase =
    TOPN (
        8,
        FILTER ( ALL ( 'FHW_Modelo'[SemanaID] ), 'FHW_Modelo'[SemanaID] <= SemanaActual ),
        'FHW_Modelo'[SemanaID], DESC
    )
VAR Tendencia =
    ADDCOLUMNS (
        SemanasBase,
        "@CTC",
            VAR SemanaPunto = 'FHW_Modelo'[SemanaID]
            RETURN
                CALCULATE (
                    AVERAGEX (
                        VALUES ( 'FHW_Modelo'[CeCo] ),
                        CALCULATE ( DIVIDE ( SUM ( 'FHW_Modelo'[FHW] ), SUM ( 'FHW_Modelo'[Bebidas Lobby] ) ) )
                    ),
                    REMOVEFILTERS ( 'FHW_Modelo'[SemanaID] ),
                    'FHW_Modelo'[SemanaID] = SemanaPunto
                )
    )
VAR MinCTC = MINX ( Tendencia, [@CTC] )
VAR MaxCTC = MAXX ( Tendencia, [@CTC] )
VAR RangoCTC = MAX ( 0.01, MaxCTC - MinCTC )
VAR TotalPuntos = COUNTROWS ( Tendencia )
VAR PuntosSVG =
    CONCATENATEX (
        Tendencia,
        VAR SemanaPunto = 'FHW_Modelo'[SemanaID]
        VAR ValorPunto = [@CTC]
        VAR Posicion = COUNTROWS ( FILTER ( Tendencia, 'FHW_Modelo'[SemanaID] <= SemanaPunto ) )
        VAR X = IF ( TotalPuntos = 1, 150, 16 + ( Posicion - 1 ) * 268 / ( TotalPuntos - 1 ) )
        VAR Y = 82 - DIVIDE ( ValorPunto - MinCTC, RangoCTC ) * 58
        RETURN FORMAT ( X, "0.0", "en-US" ) & "," & FORMAT ( Y, "0.0", "en-US" ),
        " ",
        'FHW_Modelo'[SemanaID], ASC
    )
VAR Color =
    SWITCH ( TRUE (), ISBLANK ( Movimiento ), "#6B7770", Movimiento >= 0, "#00A862", "#C74634" )
VAR Flecha =
    SWITCH ( TRUE (), ISBLANK ( Movimiento ), "•", Movimiento >= 0, "▲", "▼" )
VAR Estado =
    SWITCH ( TRUE (), ISBLANK ( Movimiento ), "Sin comparación", Movimiento >= 0, "En avance", "Atención" )
VAR Accion =
    SWITCH (
        TRUE (),
        ISBLANK ( CTCActual ), "Selecciona una tienda y una semana.",
        Movimiento >= 0, "Replica la práctica que funcionó.",
        "Observa, ofrece vajilla y acuerda una acción."
    )
VAR TiendaHtml = SUBSTITUTE ( SUBSTITUTE ( Tienda, "&", "&amp;" ), "<", "&lt;" )
VAR DMHtml = SUBSTITUTE ( SUBSTITUTE ( DM, "&", "&amp;" ), "<", "&lt;" )
RETURN
    "<div style='font-family:Segoe UI,Arial,sans-serif;background:#F4F7F5;color:#1E3932;padding:18px;border-radius:18px'>" &
    "<div style='background:#006241;color:#FFF;border-radius:14px;padding:16px 18px'>" &
    "<div style='font-size:10px;letter-spacing:1.4px;opacity:.82'>CADA TAZA CUENTA · TIENDA</div>" &
    "<div style='font-size:27px;font-weight:700;margin-top:4px'>" & TiendaHtml & "</div>" &
    "<div style='font-size:12px;opacity:.82;margin-top:3px'>" & DMHtml & " · S" & FORMAT ( SemanaActual, "0" ) & "</div></div>" &
    "<div style='display:flex;gap:10px;flex-wrap:wrap;margin-top:10px'>" &
    "<div style='flex:1;min-width:210px;background:#FFF;border-radius:13px;padding:15px'>" &
    "<div style='font-size:10px;letter-spacing:1px;color:#6B7770'>CTC ACTUAL</div>" &
    "<div style='font-size:37px;font-weight:700;color:#006241;line-height:1.1;margin-top:5px'>" & FORMAT ( CTCActual, "0.0%" ) & "</div>" &
    "<div style='font-size:11px;color:#6B7770;margin-top:4px'>FHW / Bebidas Lobby</div></div>" &
    "<div style='flex:1;min-width:170px;background:#FFF;border-radius:13px;padding:15px;border-left:5px solid " & Color & "'>" &
    "<div style='font-size:10px;letter-spacing:1px;color:#6B7770'>MOVIMIENTO</div>" &
    "<div style='font-size:27px;font-weight:700;color:" & Color & ";line-height:1.15;margin-top:7px'>" & Flecha & " " & FORMAT ( Movimiento, "0.0%" ) & "</div>" &
    "<div style='font-size:11px;color:" & Color & ";font-weight:700;margin-top:5px'>" & Estado & "</div></div>" &
    "<div style='flex:1;min-width:170px;background:#FFF;border-radius:13px;padding:15px'>" &
    "<div style='font-size:10px;letter-spacing:1px;color:#6B7770'>COBERTURA</div>" &
    "<div style='font-size:27px;font-weight:700;margin-top:7px'>" & FORMAT ( Cobertura, "0.0%" ) & "</div>" &
    "<div style='font-size:11px;color:#6B7770;margin-top:5px'>" & FORMAT ( ConUso, "#,0" ) & " / " & FORMAT ( Tiendas, "#,0" ) & " tiendas</div></div></div>" &
    "<div style='display:flex;gap:10px;flex-wrap:wrap;margin-top:10px'>" &
    "<div style='flex:2;min-width:350px;background:#FFF;border-radius:13px;padding:15px'>" &
    "<div style='display:flex;justify-content:space-between;align-items:center'><div style='font-size:10px;letter-spacing:1px;color:#6B7770'>TENDENCIA · ÚLTIMAS 8 SEMANAS</div><div style='font-size:11px;font-weight:700;color:" & Color & "'>" & Flecha & " " & FORMAT ( Movimiento, "0.0%" ) & "</div></div>" &
    "<svg viewBox='0 0 300 105' style='width:100%;height:130px;margin-top:3px' role='img' aria-label='Tendencia CTC'>" &
    "<line x1='15' y1='25' x2='285' y2='25' stroke='#E4ECE7' stroke-width='1'/>" &
    "<line x1='15' y1='54' x2='285' y2='54' stroke='#E4ECE7' stroke-width='1'/>" &
    "<line x1='15' y1='83' x2='285' y2='83' stroke='#E4ECE7' stroke-width='1'/>" &
    "<polyline points='" & PuntosSVG & "' fill='none' stroke='#006241' stroke-width='4' stroke-linecap='round' stroke-linejoin='round'/>" &
    "<text x='15' y='101' font-size='10' fill='#6B7770'>S" & FORMAT ( MINX ( Tendencia, 'FHW_Modelo'[SemanaID] ), "0" ) & "</text>" &
    "<text x='285' y='101' text-anchor='end' font-size='10' fill='#6B7770'>S" & FORMAT ( SemanaActual, "0" ) & "</text></svg></div>" &
    "<div style='flex:1;min-width:210px;background:#E8F1ED;border-radius:13px;padding:15px'>" &
    "<div style='font-size:10px;letter-spacing:1px;color:#006241'>VOLUMEN</div>" &
    "<div style='margin-top:13px'><div style='font-size:11px;color:#6B7770'>FHW</div><div style='font-size:22px;font-weight:700'>" & FORMAT ( FHWValor, "#,0" ) & "</div></div>" &
    "<div style='margin-top:10px'><div style='font-size:11px;color:#6B7770'>BEBIDAS LOBBY</div><div style='font-size:22px;font-weight:700'>" & FORMAT ( LobbyValor, "#,0" ) & "</div></div></div></div>" &
    "<div style='background:#1E3932;color:#FFF;border-radius:13px;padding:14px 16px;margin-top:10px;display:flex;justify-content:space-between;gap:12px;align-items:center'>" &
    "<div><div style='font-size:10px;letter-spacing:1px;opacity:.7'>SIGUIENTE ACCIÓN</div><div style='font-size:15px;font-weight:700;margin-top:3px'>" & Accion & "</div></div>" &
    "<div style='font-size:23px;color:#00A862'>→</div></div></div>"