// Tabla requerida: FHW_Modelo
// Medida autónoma: no requiere crear FHW, CTC %, variación ni meta adicionales.

HTML Tienda - Completo =
VAR NombreTienda =
    COALESCE ( SELECTEDVALUE ( 'FHW_Modelo'[Tienda] ), "Todas las tiendas" )
VAR NombreDM =
    COALESCE ( SELECTEDVALUE ( 'FHW_Modelo'[DM] ), "Todos los DM" )
VAR SemanaActual =
    MAX ( 'FHW_Modelo'[SemanaID] )
VAR SemanaAnterior =
    MAXX (
        FILTER (
            ALL ( 'FHW_Modelo'[SemanaID] ),
            'FHW_Modelo'[SemanaID] < SemanaActual
        ),
        'FHW_Modelo'[SemanaID]
    )
VAR CTCActual =
    AVERAGEX (
        VALUES ( 'FHW_Modelo'[CeCo] ),
        CALCULATE (
            DIVIDE (
                SUM ( 'FHW_Modelo'[FHW] ),
                SUM ( 'FHW_Modelo'[Bebidas Lobby] )
            )
        )
    )
VAR CTCAnterior =
    IF (
        NOT ISBLANK ( SemanaAnterior ),
        CALCULATE (
            AVERAGEX (
                VALUES ( 'FHW_Modelo'[CeCo] ),
                CALCULATE (
                    DIVIDE (
                        SUM ( 'FHW_Modelo'[FHW] ),
                        SUM ( 'FHW_Modelo'[Bebidas Lobby] )
                    )
                )
            ),
            REMOVEFILTERS ( 'FHW_Modelo'[SemanaID] ),
            'FHW_Modelo'[SemanaID] = SemanaAnterior
        )
    )
VAR Movimiento = CTCActual - CTCAnterior
VAR FHWActual = SUM ( 'FHW_Modelo'[FHW] )
VAR LobbyActual = SUM ( 'FHW_Modelo'[Bebidas Lobby] )
VAR TiendasVisibles = DISTINCTCOUNT ( 'FHW_Modelo'[CeCo] )
VAR TiendasConUso =
    COUNTROWS (
        FILTER (
            VALUES ( 'FHW_Modelo'[CeCo] ),
            CALCULATE (
                DIVIDE (
                    SUM ( 'FHW_Modelo'[FHW] ),
                    SUM ( 'FHW_Modelo'[Bebidas Lobby] )
                )
            ) > 0
        )
    )
VAR CoberturaUso = DIVIDE ( TiendasConUso, TiendasVisibles )
VAR ColorMovimiento =
    SWITCH (
        TRUE (),
        ISBLANK ( Movimiento ), "#6B7770",
        Movimiento > 0, "#006241",
        Movimiento < 0, "#C74634",
        "#6B7770"
    )
VAR Lectura =
    SWITCH (
        TRUE (),
        ISBLANK ( CTCActual ), "Sin datos para el corte seleccionado",
        ISBLANK ( Movimiento ), "Primera semana disponible para comparación",
        Movimiento > 0, "En avance",
        Movimiento < 0, "Oportunidad de recuperación",
        "Sin cambio frente a la semana anterior"
    )
VAR SiguienteAccion =
    SWITCH (
        TRUE (),
        ISBLANK ( CTCActual ), "Selecciona una semana completa y una tienda para iniciar la revisión.",
        Movimiento > 0, "Reconoce la práctica que funcionó y compártela en el siguiente turno.",
        Movimiento < 0, "Observa el momento de consumo, ofrece vajilla y acuerda una acción concreta con el equipo.",
        "Mantén la práctica actual y vuelve a revisar el movimiento la siguiente semana."
    )
VAR TiendaHTML =
    SUBSTITUTE ( SUBSTITUTE ( NombreTienda, "&", "&amp;" ), "<", "&lt;" )
VAR DMHTML =
    SUBSTITUTE ( SUBSTITUTE ( NombreDM, "&", "&amp;" ), "<", "&lt;" )
RETURN
    "<div style='font-family:Segoe UI,Arial,sans-serif;color:#1E3932;background:#F7F7F7;padding:20px;border-radius:18px'>" &
    "<div style='background:#006241;color:#FFFFFF;padding:18px 20px;border-radius:14px'>" &
    "<div style='font-size:11px;letter-spacing:1.3px;opacity:.86'>CADA TAZA CUENTA · TIENDA</div>" &
    "<div style='font-size:28px;font-weight:700;margin-top:5px'>" & TiendaHTML & "</div>" &
    "<div style='font-size:12px;margin-top:5px;opacity:.88'>" & DMHTML & " · Semana " & FORMAT ( SemanaActual, "0" ) & "</div>" &
    "</div>" &
    "<div style='display:flex;gap:12px;flex-wrap:wrap;margin-top:12px'>" &
    "<div style='flex:1;min-width:170px;background:#FFFFFF;border-radius:13px;padding:16px'>" &
    "<div style='font-size:11px;color:#6B7770;letter-spacing:.7px'>CTC ACTUAL</div>" &
    "<div style='font-size:32px;font-weight:700;color:#006241;margin-top:5px'>" & FORMAT ( CTCActual, "0.0%" ) & "</div>" &
    "<div style='font-size:11px;color:#6B7770;margin-top:4px'>Uso de vajilla en bebidas lobby</div></div>" &
    "<div style='flex:1;min-width:170px;background:#FFFFFF;border-radius:13px;padding:16px;border-left:5px solid " & ColorMovimiento & "'>" &
    "<div style='font-size:11px;color:#6B7770;letter-spacing:.7px'>MOVIMIENTO</div>" &
    "<div style='font-size:32px;font-weight:700;color:" & ColorMovimiento & ";margin-top:5px'>" & FORMAT ( Movimiento, "+0.0%;-0.0%;0.0%" ) & "</div>" &
    "<div style='font-size:11px;color:#6B7770;margin-top:4px'>vs. semana anterior</div></div>" &
    "<div style='flex:1;min-width:170px;background:#FFFFFF;border-radius:13px;padding:16px'>" &
    "<div style='font-size:11px;color:#6B7770;letter-spacing:.7px'>COBERTURA DE USO</div>" &
    "<div style='font-size:32px;font-weight:700;color:#1E3932;margin-top:5px'>" & FORMAT ( CoberturaUso, "0.0%" ) & "</div>" &
    "<div style='font-size:11px;color:#6B7770;margin-top:4px'>" & FORMAT ( TiendasConUso, "#,0" ) & " de " & FORMAT ( TiendasVisibles, "#,0" ) & " tiendas</div></div></div>" &
    "<div style='display:flex;gap:12px;flex-wrap:wrap;margin-top:12px'>" &
    "<div style='flex:1;min-width:220px;background:#E8F1ED;border-radius:13px;padding:16px'>" &
    "<div style='font-size:11px;color:#006241;letter-spacing:.7px'>FHW</div>" &
    "<div style='font-size:23px;font-weight:700;margin-top:5px'>" & FORMAT ( FHWActual, "#,0" ) & "</div></div>" &
    "<div style='flex:1;min-width:220px;background:#E8F1ED;border-radius:13px;padding:16px'>" &
    "<div style='font-size:11px;color:#006241;letter-spacing:.7px'>BEBIDAS LOBBY</div>" &
    "<div style='font-size:23px;font-weight:700;margin-top:5px'>" & FORMAT ( LobbyActual, "#,0" ) & "</div></div></div>" &
    "<div style='background:#FFFFFF;border-radius:13px;padding:17px;margin-top:12px'>" &
    "<div style='font-size:11px;color:#6B7770;letter-spacing:1px'>LECTURA DE MEJORA CONTINUA</div>" &
    "<div style='font-size:19px;font-weight:700;color:" & ColorMovimiento & ";margin-top:6px'>" & Lectura & "</div>" &
    "<div style='font-size:13px;line-height:1.45;color:#4B5B53;margin-top:5px'>" & SiguienteAccion & "</div></div></div>"
